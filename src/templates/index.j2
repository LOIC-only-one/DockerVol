{% extends "base.j2" %}
{% block content %}
<section id="jobs" hidden>
  <div class="head"><h2>Tâches</h2></div>
  <div id="job-list"></div>
</section>

<section>
  <div class="head">
    <h2>Volumes <span class="count">{{ volumes|length }}</span></h2>
    {% if volumes %}
    <form method="post" action="{{ url_for('archive_all') }}">
      <button class="secondary">Tout archiver</button>
    </form>
    {% endif %}
  </div>
  {% if error %}
    <div class="body"><div class="flash err">{{ error }}</div></div>
  {% elif not volumes %}
    <div class="body muted">Aucun volume.</div>
  {% else %}
  <table>
    {% for v in volumes %}
      <tr>
        <td class="name">{{ v }}</td>
        <td class="act"><form method="post" action="{{ url_for('archive', name=v) }}"><button class="secondary">Archiver</button></form></td>
      </tr>
    {% endfor %}
  </table>
  {% endif %}
</section>

{% if volumes %}
<section>
  <div class="head"><h2>Réplication SSH</h2></div>
  <form class="body" method="post" id="transfer"
        onsubmit="this.action = '{{ url_for('transfer', name='__V__') }}'.replace('__V__', encodeURIComponent(this.volume.value))">
    <div class="grid">
      <div><label for="volume">Volume</label>
        <select id="volume" name="volume">{% for v in volumes %}<option>{{ v }}</option>{% endfor %}</select></div>
      <div><label for="host">Hôte</label><input id="host" name="host" required placeholder="192.168.1.10"></div>
      <div><label for="user">Utilisateur</label><input id="user" name="user" required></div>
      <div><label for="password">Mot de passe</label><input id="password" name="password" type="password" required></div>
      <div><label for="remote_dir">Dossier distant</label><input id="remote_dir" name="remote_dir" value="/tmp"></div>
    </div>
    <button>Archiver et transférer</button>
  </form>
</section>
{% endif %}

<script>
  const fmtSize = n => {
    const u = ["o", "Ko", "Mo", "Go", "To"]; let i = 0;
    while (n >= 1024 && i < u.length - 1) { n /= 1024; i++; }
    return n.toFixed(i ? 1 : 0).replace(".", ",") + " " + u[i];
  };
  const fmtTime = s => {
    s = Math.ceil(s);
    if (s < 60) return s + " s";
    if (s < 3600) return Math.floor(s / 60) + " min " + String(s % 60).padStart(2, "0") + " s";
    return Math.floor(s / 3600) + " h " + String(Math.floor(s % 3600 / 60)).padStart(2, "0") + " min";
  };
  const el = (tag, cls, text) => {
    const e = document.createElement(tag);
    if (cls) e.className = cls;
    if (text != null) e.textContent = text;  // textContent: volume names and errors are never parsed as HTML
    return e;
  };

  function describe(j) {
    if (j.status === "queued") return "En attente";
    if (j.status === "error") return "Erreur : " + j.error;
    if (j.status === "done") return "Terminé → " + j.result;
    if (!j.total) return j.phase + "…";
    const parts = [j.phase, Math.floor(100 * j.done / j.total) + " %", fmtSize(j.done) + " / " + fmtSize(j.total)];
    parts.push(j.eta == null ? "calcul du temps restant…" : "reste " + fmtTime(j.eta));
    return parts.join(" · ");
  }

  async function poll() {
    let list;
    try { list = await (await fetch("{{ url_for('job_list') }}")).json(); }
    catch { return setTimeout(poll, 3000); }
    document.getElementById("jobs").hidden = list.length === 0;
    const box = document.getElementById("job-list");
    box.replaceChildren(...list.map(j => {
      const row = el("div", "job " + j.status), line = el("div", "line"), bar = el("div", "bar"), fill = el("div");
      line.append(el("span", "vol", j.volume), el("span", "info" + (j.status === "error" ? " err" : ""), describe(j)));
      fill.style.width = (j.status === "done" ? 100 : j.total ? 100 * j.done / j.total : 0) + "%";
      bar.append(fill);
      row.append(line, bar);
      return row;
    }));
    if (list.some(j => j.status === "queued" || j.status === "running")) setTimeout(poll, 1000);
  }
  poll();
</script>
{% endblock %}
