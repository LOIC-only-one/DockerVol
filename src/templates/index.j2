{% extends "base.j2" %}
{% block content %}
<section id="jobs" hidden>
  <div class="head"><h2>Tâches</h2></div>
  <div id="job-list"></div>
</section>

{# Un seul formulaire : la sélection sert aux deux boutons (formaction). #}
<form method="post" id="main" action="{{ url_for('archive') }}">
<section>
  <div class="head">
    <h2>Volumes <span class="count">{{ volumes|length }}</span></h2>
    {% if volumes %}<input type="search" id="filter" placeholder="Filtrer…" aria-label="Filtrer les volumes">{% endif %}
  </div>
  {% if error %}
    <div class="body"><div class="flash err">{{ error }}</div></div>
  {% elif not volumes %}
    <div class="body muted">Aucun volume.</div>
  {% else %}
  <table id="volumes">
    <thead><tr>
      <th class="chk"><input type="checkbox" id="all" aria-label="Tout sélectionner"></th>
      <th>Nom</th><th class="num">Taille</th>
    </tr></thead>
    <tbody>
    {% for v, info in volumes.items() %}
      <tr data-name="{{ v }}">
        <td class="chk"><input type="checkbox" name="names" value="{{ v }}" aria-label="{{ v }}"{% if info.problem %} disabled{% endif %}></td>
        <td class="name">{{ v }}{% if info.problem %}<div class="warn">{{ info.problem }}</div>{% endif %}</td>
        <td class="num size muted">…</td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
  <div class="actions">
    <span id="selected" class="muted">0 sélectionné</span>
    <label class="inline" {% if not can_stop %}title="Nécessite la commande docker (socket Docker monté dans l'image)"{% endif %}>
      <input type="checkbox" name="stop"{% if not can_stop %} disabled{% endif %}> Arrêter les conteneurs pendant l'archivage
    </label>
    <button class="secondary" formnovalidate disabled data-needs-selection>Archiver</button>
  </div>
  {% endif %}
</section>

{% if volumes %}
<section>
  <div class="head"><h2>Migrer vers Swarm</h2><div class="steps"><span>archive</span>→<span>envoi SSH</span>→<span>sha256</span>→<span>restauration</span></div></div>
  <div class="body">
    <fieldset class="modes">
      <legend>Destination</legend>
      <label class="mode"><input type="radio" name="mode" value="node" checked>
        <span><b>Nœud précis</b><br><span class="muted small"><code>docker volume create</code> sur ce nœud (contrainte de placement)</span></span></label>
      <label class="mode"><input type="radio" name="mode" value="shared">
        <span><b>Stockage partagé</b><br><span class="muted small">extraction dans <code>&lt;dossier&gt;/&lt;volume&gt;</code> (NFS, GlusterFS…)</span></span></label>
    </fieldset>
    <div class="grid">
      <div><label for="host">Hôte</label><input id="host" name="host" required placeholder="192.168.1.10"></div>
      <div><label for="port">Port</label><input id="port" name="port" type="number" value="22" min="1" max="65535"></div>
      <div><label for="user">Utilisateur</label><input id="user" name="user" required value="root"></div>
      <div class="wide"><label for="key_path">Clé privée <span class="muted">(chemin)</span></label><input id="key_path" name="key_path" placeholder="/root/.ssh/id_ed25519"></div>
      <div><label for="password">Mot de passe <span class="muted">(si pas de clé)</span></label><input id="password" name="password" type="password" autocomplete="off"></div>
      <div id="shared-field" class="wide" hidden><label for="shared_dir">Dossier partagé</label><input id="shared_dir" name="shared_dir" placeholder="/mnt/nfs/volumes"></div>
    </div>
    <div class="submit">
      <span class="muted small">Rien n'est écrasé : un volume déjà présent sur la cible fait échouer la tâche.</span>
      <button formaction="{{ url_for('migrate') }}" disabled data-needs-selection style="margin-left:auto">Migrer la sélection</button>
    </div>
  </div>
</section>
{% endif %}
</form>

<section>
  <div class="head"><h2>Archives <span class="count">{{ archives|length }}</span></h2></div>
  {% if not archives %}
    <div class="body muted">Aucune archive.</div>
  {% else %}
  <table>
    <thead><tr><th>Fichier</th><th class="num">Taille</th><th class="num">Date</th><th></th></tr></thead>
    <tbody>
    {% for a in archives %}
      <tr>
        <td class="name">{{ a.name }}</td>
        <td class="num muted" data-bytes="{{ a.size }}"></td>
        <td class="num muted" data-time="{{ a.mtime }}"></td>
        <td class="act"><div>
          <a class="btn" href="{{ url_for('download_archive', name=a.name) }}" download>Télécharger</a>
          <form method="post" action="{{ url_for('delete_archive', name=a.name) }}" onsubmit="return confirm('Supprimer cette archive ?')">
            <button class="danger">Supprimer</button></form>
        </div></td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
  {% endif %}
</section>

<script>
  const fmtSize = n => {
    const u = ["o", "Ko", "Mo", "Go", "To"]; let i = 0;
    while (n >= 1024 && i < u.length - 1) { n /= 1024; i++; }
    return n.toFixed(i ? 1 : 0).replace(".", ",") + " " + u[i];
  };
  const fmtTime = s => {
    s = Math.ceil(s);
    if (s < 60) return s + " s";
    if (s < 3600) return Math.floor(s / 60) + " min " + String(s % 60).padStart(2, "0") + " s";
    return Math.floor(s / 3600) + " h " + String(Math.floor(s % 3600 / 60)).padStart(2, "0") + " min";
  };
  const el = (tag, cls, text) => {
    const e = document.createElement(tag);
    if (cls) e.className = cls;
    if (text != null) e.textContent = text;  // textContent: volume names and errors are never parsed as HTML
    return e;
  };
  const $ = s => document.querySelector(s), $$ = s => [...document.querySelectorAll(s)];

  // Archives : taille et date lisibles.
  $$("[data-bytes]").forEach(td => td.textContent = fmtSize(+td.dataset.bytes));
  $$("[data-time]").forEach(td => td.textContent = new Date(td.dataset.time * 1000).toLocaleString("fr-FR", {dateStyle: "short", timeStyle: "short"}));

  // Sélection : compteur, boutons, case « tout ».
  const boxes = $$("input[name=names]:not(:disabled)");
  function refresh() {
    const n = boxes.filter(b => b.checked).length;
    if ($("#selected")) $("#selected").textContent = n + " sélectionné" + (n > 1 ? "s" : "");
    $$("[data-needs-selection]").forEach(b => b.disabled = n === 0);
  }
  boxes.forEach(b => b.addEventListener("change", refresh));
  // Clic n'importe où sur la ligne = cocher la case.
  $$("#volumes tbody tr").forEach(tr => tr.addEventListener("click", e => {
    const b = tr.querySelector("input[name=names]");
    if (e.target === b || b.disabled) return;
    b.checked = !b.checked; refresh();
  }));
  $("#all")?.addEventListener("change", e => {
    boxes.forEach(b => { if (!b.closest("tr").hidden) b.checked = e.target.checked; });
    refresh();
  });

  // Filtre par nom.
  $("#filter")?.addEventListener("input", e => {
    const q = e.target.value.toLowerCase();
    $$("#volumes tbody tr").forEach(tr => tr.hidden = !tr.dataset.name.toLowerCase().includes(q));
  });

  // Mode de destination : le dossier partagé n'est demandé qu'en mode partagé.
  $$("input[name=mode]").forEach(r => r.addEventListener("change", () => {
    const shared = $("input[name=mode]:checked").value === "shared";
    $("#shared-field").hidden = !shared;
    $("#shared_dir").required = shared;
  }));

  // Tailles calculées après l'affichage (parcours de tous les fichiers).
  if (boxes.length || $("#volumes")) fetch("{{ url_for('sizes') }}").then(r => r.json()).then(sizes => {
    $$("#volumes tbody tr").forEach(tr => {
      const s = sizes[tr.dataset.name];
      tr.querySelector(".size").textContent = s == null ? "—" : fmtSize(s);
    });
  }).catch(() => {});

  const ACTIONS = {archive: "Archivage", migrate: "Migration"};
  function describe(j) {
    if (j.status === "queued") return "En attente";
    if (j.status === "error") return "Erreur : " + j.error;
    if (j.status === "done") return "Terminé → " + j.result;
    if (!j.total) return j.phase + "…";
    const parts = [j.phase, Math.floor(100 * j.done / j.total) + " %", fmtSize(j.done) + " / " + fmtSize(j.total)];
    parts.push(j.eta == null ? "calcul du temps restant…" : "reste " + fmtTime(j.eta));
    return parts.join(" · ");
  }

  let wasRunning = false;
  async function poll() {
    let list;
    try { list = await (await fetch("{{ url_for('job_list') }}")).json(); }
    catch { return setTimeout(poll, 3000); }
    $("#jobs").hidden = list.length === 0;
    $("#job-list").replaceChildren(...list.map(j => {
      const row = el("div", "job " + j.status), line = el("div", "line"), bar = el("div", "bar"), fill = el("div");
      const who = el("span", "vol", j.volume);
      who.prepend(el("span", "tag", ACTIONS[j.action] || j.action));
      line.append(who, el("span", "info" + (j.status === "error" ? " err" : ""), describe(j)));
      fill.style.width = (j.status === "done" ? 100 : j.total ? 100 * j.done / j.total : 0) + "%";
      bar.append(fill);
      row.append(line, bar);
      return row;
    }));
    const running = list.some(j => j.status === "queued" || j.status === "running");
    if (running) { wasRunning = true; setTimeout(poll, 1000); }
    else if (wasRunning) location.reload();  // nouvelles archives à afficher
  }
  poll();
</script>
{% endblock %}
