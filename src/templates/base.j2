<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>DockerVol</title>
  <link rel="icon" href="{{ url_for('static', filename='logo.svg') }}" type="image/svg+xml">
  <style>
    @font-face { font-family: "Atkinson Hyperlegible"; font-weight: 400; font-display: swap; src: url("{{ url_for('static', filename='fonts/atkinson-hyperlegible-latin-400-normal.woff2') }}") format("woff2"); }
    @font-face { font-family: "Atkinson Hyperlegible"; font-weight: 700; font-display: swap; src: url("{{ url_for('static', filename='fonts/atkinson-hyperlegible-latin-700-normal.woff2') }}") format("woff2"); }
    @font-face { font-family: "IBM Plex Mono"; font-weight: 400; font-display: swap; src: url("{{ url_for('static', filename='fonts/ibm-plex-mono-latin-400-normal.woff2') }}") format("woff2"); }
    :root {
      --primary: #2496ED;        /* couleur principale : changer ici */
      --primary-dark: #1A7FCC;
      --bg: #F6F7F9;
      --card: #FFFFFF;
      --text: #1F2328;
      --muted: #656D76;
      --border: #D8DEE4;
      --ok: #1A7F37;
      --err: #CF222E;
    }
    @media (prefers-color-scheme: dark) {
      :root { --bg: #0D1117; --card: #161B22; --text: #E6EDF3; --muted: #8D96A0; --border: #30363D; --ok: #3FB950; --err: #F85149; }
    }
    * { box-sizing: border-box; }
    body { margin: 0; font: 15px/1.5 "Atkinson Hyperlegible", system-ui, sans-serif; background: var(--bg); color: var(--text); }
    header { background: var(--card); border-bottom: 1px solid var(--border); }
    header .inner { max-width: 960px; margin: 0 auto; padding: 12px 16px; display: flex; align-items: center; gap: 10px; }
    header img { width: 26px; height: 26px; }
    header .brand { font-weight: 700; font-size: 16px; }
    header .host { margin-left: auto; color: var(--muted); font-family: "IBM Plex Mono", ui-monospace, monospace; font-size: 12px; }
    main { max-width: 960px; margin: 20px auto; padding: 0 16px; }
    section { background: var(--card); border: 1px solid var(--border); border-radius: 6px; margin-bottom: 16px; }
    section > .head { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; padding: 10px 14px; border-bottom: 1px solid var(--border); }
    section > .body { padding: 14px; }
    h2 { margin: 0; font-size: 14px; font-weight: 700; }
    .count { color: var(--muted); font-weight: 400; }
    table { width: 100%; border-collapse: collapse; }
    td { padding: 8px 14px; border-top: 1px solid var(--border); vertical-align: middle; }
    tr:first-child td { border-top: 0; }
    tr:hover td { background: var(--bg); }
    td.name { font-family: "IBM Plex Mono", ui-monospace, monospace; font-size: 13px; word-break: break-all; }
    td.act { width: 1%; white-space: nowrap; }
    button { background: var(--primary); color: #fff; border: 1px solid var(--primary-dark); border-radius: 4px; padding: 4px 12px; font: inherit; font-size: 13px; cursor: pointer; }
    button:hover { background: var(--primary-dark); }
    button.secondary { background: var(--card); color: var(--text); border-color: var(--border); }
    button.secondary:hover { background: var(--bg); }
    button:disabled { opacity: .5; cursor: not-allowed; }
    input, select { width: 100%; padding: 5px 8px; border: 1px solid var(--border); border-radius: 4px; background: var(--bg); color: var(--text); font: inherit; }
    input:focus, select:focus { outline: 2px solid var(--primary); outline-offset: -1px; }
    label { display: block; font-size: 12px; font-weight: 700; margin-bottom: 4px; }
    .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 12px; margin-bottom: 14px; }
    .flash { padding: 8px 12px; border: 1px solid; border-left-width: 3px; border-radius: 4px; margin-bottom: 12px; background: var(--card); }
    .flash.ok { border-color: var(--ok); } .flash.err { border-color: var(--err); }
    .muted { color: var(--muted); }
    .job { padding: 10px 14px; border-top: 1px solid var(--border); }
    .job:first-child { border-top: 0; }
    .job .line { display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; margin-bottom: 6px; }
    .job .vol { font-family: "IBM Plex Mono", ui-monospace, monospace; font-size: 13px; word-break: break-all; }
    .job .info { color: var(--muted); font-size: 12px; font-variant-numeric: tabular-nums; }
    .job .info.err { color: var(--err); }
    th { text-align: left; font-size: 12px; color: var(--muted); font-weight: 700; padding: 8px 14px; border-bottom: 1px solid var(--border); }
    thead + tbody tr:first-child td { border-top: 0; }
    td.chk, th.chk { width: 1%; padding-right: 0; }
    td.num, th.num { text-align: right; white-space: nowrap; font-variant-numeric: tabular-nums; font-size: 13px; }
    td.act { display: flex; gap: 6px; justify-content: flex-end; }
    td.act form { margin: 0; }
    tr[hidden] { display: none; }
    input[type=checkbox], input[type=radio] { width: auto; accent-color: var(--primary); margin: 0; }
    input[type=search] { width: 220px; }
    .warn { color: var(--err); font-family: "Atkinson Hyperlegible", system-ui, sans-serif; font-size: 12px; }
    .small { font-size: 12px; }
    .actions { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; padding: 10px 14px; border-top: 1px solid var(--border); position: sticky; bottom: 0; background: var(--card); border-radius: 0 0 6px 6px; }
    .actions button { margin-left: auto; }
    label.inline { display: flex; align-items: center; gap: 6px; font-weight: 400; font-size: 13px; margin: 0; }
    fieldset.modes { border: 0; padding: 0; margin: 0 0 14px; display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 10px; }
    fieldset.modes legend { font-size: 12px; font-weight: 700; margin-bottom: 6px; padding: 0; }
    label.mode { display: flex; gap: 10px; align-items: flex-start; font-weight: 400; font-size: 14px; padding: 10px 12px; border: 1px solid var(--border); border-radius: 6px; cursor: pointer; margin: 0; }
    label.mode:has(input:checked) { border-color: var(--primary); box-shadow: inset 0 0 0 1px var(--primary); }
    label.mode input { margin-top: 3px; }
    a.btn { display: inline-block; text-decoration: none; border: 1px solid var(--border); border-radius: 4px; padding: 4px 12px; font-size: 13px; color: var(--text); background: var(--card); }
    a.btn:hover { background: var(--bg); }
    button.danger { background: var(--card); color: var(--err); border-color: var(--border); }
    button.danger:hover { background: var(--err); color: #fff; border-color: var(--err); }
    .tag { display: inline-block; font-family: "Atkinson Hyperlegible", system-ui, sans-serif; font-size: 11px; font-weight: 700; color: var(--primary); border: 1px solid var(--primary); border-radius: 3px; padding: 0 5px; margin-right: 8px; }
    .bar { height: 6px; background: var(--bg); border: 1px solid var(--border); border-radius: 3px; overflow: hidden; }
    .bar > div { height: 100%; width: 0; background: var(--primary); transition: width .4s linear; }
    .job.done .bar > div { background: var(--ok); }
    .job.error .bar > div { background: var(--err); }
  </style>
</head>
<body>
  <header>
    <div class="inner">
      <img src="{{ url_for('static', filename='logo.svg') }}" alt="">
      <span class="brand">DockerVol</span>
      {% if source %}<span class="host">{{ source }}</span>{% endif %}
    </div>
  </header>
  <main>
    {% for cat, msg in get_flashed_messages(with_categories=true) %}
      <div class="flash {{ cat }}" role="status">{{ msg }}</div>
    {% endfor %}
    {% block content %}{% endblock %}
  </main>
</body>
</html>
