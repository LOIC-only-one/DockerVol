<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>DockerVol</title>
  <link rel="icon" href="{{ url_for('static', filename='logo.svg') }}" type="image/svg+xml">
  <style>
    @font-face { font-family: "Atkinson Hyperlegible"; font-weight: 400; font-display: swap; src: url("{{ url_for('static', filename='fonts/atkinson-hyperlegible-latin-400-normal.woff2') }}") format("woff2"); }
    @font-face { font-family: "Atkinson Hyperlegible"; font-weight: 700; font-display: swap; src: url("{{ url_for('static', filename='fonts/atkinson-hyperlegible-latin-700-normal.woff2') }}") format("woff2"); }
    @font-face { font-family: "IBM Plex Mono"; font-weight: 400; font-display: swap; src: url("{{ url_for('static', filename='fonts/ibm-plex-mono-latin-400-normal.woff2') }}") format("woff2"); }
    :root {
      --primary: #1D63ED;        /* couleur principale : changer ici */
      --primary-dark: #1550C4;
      --primary-soft: #EBF1FE;
      --bg: #F3F5F8;
      --card: #FFFFFF;
      --field: #FFFFFF;
      --text: #1A1F27;
      --muted: #5F6B7A;
      --border: #DCE1E8;
      --ok: #1A7F37;
      --err: #CF222E;
      --shadow: 0 1px 2px rgba(16, 24, 40, .05), 0 1px 3px rgba(16, 24, 40, .06);
      --mono: "IBM Plex Mono", ui-monospace, monospace;
    }
    @media (prefers-color-scheme: dark) {
      :root { --primary: #3D7BF5; --primary-dark: #2A66E0; --primary-soft: #172A4D; --bg: #0E1218; --card: #161B23; --field: #0E1218; --text: #E6EAF0; --muted: #8E99A8; --border: #2A313C; --ok: #3FB950; --err: #F85149; --shadow: none; }
    }
    * { box-sizing: border-box; }
    body { margin: 0; font: 15px/1.5 "Atkinson Hyperlegible", system-ui, sans-serif; background: var(--bg); color: var(--text); -webkit-font-smoothing: antialiased; }
    header { background: var(--card); border-bottom: 1px solid var(--border); }
    header .inner { max-width: 1000px; margin: 0 auto; padding: 14px 20px; display: flex; align-items: center; gap: 10px; }
    header img { width: 28px; height: 28px; }
    header .brand { font-weight: 700; font-size: 17px; letter-spacing: -.01em; }
    header .host { margin-left: auto; color: var(--muted); font-family: var(--mono); font-size: 12px; background: var(--bg); border: 1px solid var(--border); border-radius: 999px; padding: 3px 12px; max-width: 55%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; direction: rtl; }
    main { max-width: 1000px; margin: 28px auto; padding: 0 20px; }
    section { background: var(--card); border: 1px solid var(--border); border-radius: 10px; margin-bottom: 20px; box-shadow: var(--shadow); }
    section > .head { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; padding: 14px 18px; border-bottom: 1px solid var(--border); }
    section > .body { padding: 18px; }
    h2 { margin: 0; font-size: 16px; font-weight: 700; display: flex; align-items: center; gap: 8px; }
    .count { color: var(--muted); font-weight: 700; font-size: 12px; background: var(--bg); border: 1px solid var(--border); border-radius: 999px; padding: 0 8px; line-height: 20px; font-family: var(--mono); }
    table { width: 100%; border-collapse: collapse; }
    td { padding: 11px 18px; border-top: 1px solid var(--border); vertical-align: middle; }
    tr:first-child td { border-top: 0; }
    tbody tr:hover td { background: var(--bg); }
    #volumes tbody tr { cursor: pointer; }
    #volumes tbody tr:has(input:checked) td { background: var(--primary-soft); }
    td.name { font-family: var(--mono); font-size: 13px; word-break: break-all; }
    button, a.btn { display: inline-flex; align-items: center; height: 34px; background: var(--primary); color: #fff; border: 1px solid var(--primary); border-radius: 7px; padding: 0 16px; font: inherit; font-size: 14px; font-weight: 700; cursor: pointer; text-decoration: none; transition: background .15s, border-color .15s; }
    button:hover { background: var(--primary-dark); border-color: var(--primary-dark); }
    button.secondary, a.btn { background: var(--card); color: var(--text); border-color: var(--border); }
    button.secondary:hover, a.btn:hover { background: var(--bg); border-color: var(--muted); }
    button:disabled, button:disabled:hover { opacity: .45; cursor: not-allowed; background: var(--primary); border-color: var(--primary); }
    button.secondary:disabled { background: var(--card); border-color: var(--border); }
    td.act button, td.act a.btn { height: 30px; padding: 0 12px; font-size: 13px; }
    input, select { width: 100%; height: 38px; padding: 0 11px; border: 1px solid var(--border); border-radius: 7px; background: var(--field); color: var(--text); font: inherit; transition: border-color .15s, box-shadow .15s; }
    input:hover { border-color: var(--muted); }
    input:focus, select:focus { outline: none; border-color: var(--primary); box-shadow: 0 0 0 3px var(--primary-soft); }
    input::placeholder { color: var(--muted); opacity: .7; }
    label { display: block; font-size: 13px; font-weight: 700; margin-bottom: 6px; }
    .grid { display: grid; grid-template-columns: 2fr 1fr 1.4fr; gap: 14px 16px; margin-bottom: 18px; }
    .grid .wide { grid-column: span 2; }
    @media (max-width: 640px) { .grid { grid-template-columns: 1fr; } .grid .wide { grid-column: auto; } }
    .flash { padding: 10px 14px; border: 1px solid var(--border); border-left: 4px solid; border-radius: 7px; margin-bottom: 16px; background: var(--card); box-shadow: var(--shadow); }
    .flash.ok { border-left-color: var(--ok); } .flash.err { border-left-color: var(--err); }
    .muted { color: var(--muted); }
    .job { padding: 12px 18px; border-top: 1px solid var(--border); }
    .job:first-child { border-top: 0; }
    .job .line { display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; margin-bottom: 8px; }
    .job .vol { font-family: var(--mono); font-size: 13px; word-break: break-all; }
    .job .info { color: var(--muted); font-size: 12px; font-family: var(--mono); }
    .job .info.err { color: var(--err); }
    th { text-align: left; font-size: 12px; color: var(--muted); font-weight: 700; text-transform: uppercase; letter-spacing: .04em; padding: 9px 18px; border-bottom: 1px solid var(--border); background: var(--bg); }
    thead + tbody tr:first-child td { border-top: 0; }
    td.chk, th.chk { width: 1%; padding-right: 0; }
    td.num, th.num { text-align: right; white-space: nowrap; font-family: var(--mono); font-size: 12px; }
    td.act { width: 1%; white-space: nowrap; }
    td.act > div { display: flex; gap: 8px; justify-content: flex-end; }
    td.act form { margin: 0; }
    tr[hidden] { display: none; }
    input[type=checkbox], input[type=radio] { width: 16px; height: 16px; accent-color: var(--primary); margin: 0; cursor: pointer; }
    input[type=search] { width: 240px; height: 34px; background: var(--bg); }
    .warn { color: var(--err); font-family: "Atkinson Hyperlegible", system-ui, sans-serif; font-size: 12px; margin-top: 2px; }
    .small { font-size: 13px; }
    .actions { display: flex; align-items: center; gap: 20px; flex-wrap: wrap; padding: 12px 18px; border-top: 1px solid var(--border); position: sticky; bottom: 0; background: var(--card); border-radius: 0 0 10px 10px; }
    .actions button { margin-left: auto; }
    #selected { font-weight: 700; font-size: 14px; }
    label.inline { display: flex; align-items: center; gap: 8px; font-weight: 400; font-size: 14px; margin: 0; cursor: pointer; }
    fieldset.modes { border: 0; padding: 0; margin: 0 0 20px; display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 12px; }
    fieldset.modes legend { font-size: 13px; font-weight: 700; margin-bottom: 8px; padding: 0; }
    label.mode { display: flex; gap: 12px; align-items: flex-start; font-weight: 400; font-size: 15px; padding: 14px 16px; border: 1px solid var(--border); border-radius: 9px; cursor: pointer; margin: 0; transition: border-color .15s, background .15s; }
    label.mode:hover { border-color: var(--muted); }
    label.mode:has(input:checked) { border-color: var(--primary); background: var(--primary-soft); box-shadow: inset 0 0 0 1px var(--primary); }
    label.mode input { margin-top: 3px; }
    label.mode code { font-family: var(--mono); font-size: 12px; }
    .submit { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; padding-top: 16px; border-top: 1px solid var(--border); }
    .steps { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; font-size: 12px; color: var(--muted); }
    .steps span { background: var(--bg); border: 1px solid var(--border); border-radius: 999px; padding: 1px 9px; }
    button.danger { background: var(--card); color: var(--err); border-color: var(--border); }
    button.danger:hover { background: var(--err); color: #fff; border-color: var(--err); }
    .tag { display: inline-block; font-family: "Atkinson Hyperlegible", system-ui, sans-serif; font-size: 11px; font-weight: 700; color: var(--primary); background: var(--primary-soft); border-radius: 999px; padding: 1px 8px; margin-right: 8px; }
    .bar { height: 6px; background: var(--bg); border-radius: 999px; overflow: hidden; }
    .bar > div { height: 100%; width: 0; background: var(--primary); border-radius: 999px; transition: width .4s linear; }
    .job.done .bar > div { background: var(--ok); }
    .job.error .bar > div { background: var(--err); }
  </style>
</head>
<body>
  <header>
    <div class="inner">
      <img src="{{ url_for('static', filename='logo.svg') }}" alt="">
      <span class="brand">DockerVol</span>
      {% if source %}<span class="host" title="{{ source }}"><bdi>{{ source }}</bdi></span>{% endif %}
    </div>
  </header>
  <main>
    {% for cat, msg in get_flashed_messages(with_categories=true) %}
      <div class="flash {{ cat }}" role="status">{{ msg }}</div>
    {% endfor %}
    {% block content %}{% endblock %}
  </main>
</body>
</html>
